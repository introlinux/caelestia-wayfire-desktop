+static void json_append_escaped(GString *buf, const char *s) {
+  g_string_append_c(buf, '"');
+  for (const unsigned char *p = (const unsigned char *)(s ? s : ""); *p; p++) {
+    switch (*p) {
+      case '"': g_string_append(buf, "\\\""); break;
+      case '\\': g_string_append(buf, "\\\\"); break;
+      case '\n': g_string_append(buf, "\\n"); break;
+      case '\r': g_string_append(buf, "\\r"); break;
+      case '\t': g_string_append(buf, "\\t"); break;
+      default:
+        if (*p < 0x20) {
+          g_string_append_printf(buf, "\\u%04x", *p);
+        } else {
+          g_string_append_c(buf, (char)*p);
+        }
+    }
+  }
+  g_string_append_c(buf, '"');
+}
+
+// Vuelca la disposición recién aplicada a un JSON temporal y se lo pasa a
+// caelestia-save-layout, que lo persiste en ~/.config/caelestia/output-layouts.json
+// indexado por identidad (make/model/serial/tamaño físico) para que
+// caelestia-auto-scale pueda restaurarla en futuros arranques/hotplugs,
+// incluso si el nombre del conector cambia entre máquinas.
+static void wd_persist_layout(struct wl_list *outputs) {
+  GString *buf = g_string_new("[");
+  bool first = true;
+  struct wd_head_config *output;
+  wl_list_for_each(output, outputs, link) {
+    struct wd_head *head = output->head;
+    if (!first) {
+      g_string_append_c(buf, ',');
+    }
+    first = false;
+    g_string_append(buf, "{\"make\":");
+    json_append_escaped(buf, head->make);
+    g_string_append(buf, ",\"model\":");
+    json_append_escaped(buf, head->model);
+    g_string_append(buf, ",\"serial\":");
+    json_append_escaped(buf, head->serial);
+    g_string_append_printf(buf,
+        ",\"phys_width\":%d,\"phys_height\":%d"
+        ",\"enabled\":%s,\"width\":%d,\"height\":%d,\"refresh_mhz\":%d"
+        ",\"x\":%d,\"y\":%d,\"scale\":%f,\"transform\":%d}",
+        head->phys_width, head->phys_height,
+        output->enabled ? "true" : "false",
+        output->width, output->height, output->refresh,
+        output->x, output->y, output->scale, (int)output->transform);
+  }
+  g_string_append_c(buf, ']');
+
+  GError *error = NULL;
+  gchar *path = NULL;
+  gint fd = g_file_open_tmp("wdisplays-apply-XXXXXX.json", &path, &error);
+  if (fd < 0) {
+    fprintf(stderr, "wdisplays: no se pudo crear fichero temporal para guardar layout: %s\n",
+        error ? error->message : "?");
+    g_clear_error(&error);
+    g_string_free(buf, TRUE);
+    return;
+  }
+  ssize_t written = write(fd, buf->str, buf->len);
+  close(fd);
+  bool ok = written >= 0 && (gsize)written == buf->len;
+  g_string_free(buf, TRUE);
+  if (!ok) {
+    fprintf(stderr, "wdisplays: fallo escribiendo layout temporal\n");
+    unlink(path);
+    g_free(path);
+    return;
+  }
+
+  gchar *argv[] = {"caelestia-save-layout", path, NULL};
+  GError *spawn_error = NULL;
+  if (!g_spawn_async(NULL, argv, NULL,
+      G_SPAWN_SEARCH_PATH | G_SPAWN_STDOUT_TO_DEV_NULL | G_SPAWN_STDERR_TO_DEV_NULL,
+      NULL, NULL, NULL, &spawn_error)) {
+    fprintf(stderr, "wdisplays: no se pudo lanzar caelestia-save-layout: %s\n",
+        spawn_error ? spawn_error->message : "?");
+    g_clear_error(&spawn_error);
+    unlink(path);
+  }
+  g_free(path);
+}
