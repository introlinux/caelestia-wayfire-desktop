    gl*) T_TITLE="Traspasa"
         T_NOUEFI="Este equipo non arrincou en modo UEFI, así que non se pode preparar o arranque do sistema traspasado.\n\nArrinque en modo UEFI e ténteo de novo."
         T_NOTOOL="Falta unha ferramenta necesaria:"
         T_ANALIZA="Analizando o sistema e as particións…\nEstase a calcular o espazo necesario."
         T_ERRINSPECT="Non se puido analizar o sistema. Cancelouse a autenticación?"
         T_NOPART="Non se atopou ningunha partición que poida recibir o sistema.\n\nPrepare (particione e formate) o disco de destino antes de usar este aplicativo."
         T_SELTEXT="Escolla a partición de destino. Copiarase o sistema e quedará arrincable.\n\nEspazo necesario: %s só o sistema · %s cos datos persoais"
         C_PART="Partición" C_DEV="Dispositivo" C_SIZE="Tamaño" C_FS="Formato"
         C_LABEL="Etiqueta" C_FREE="Libre" C_STATE="Estado"
         T_VACIA="★ baleira" T_CONDATOS="con datos" T_DESCONOCIDA="sen comprobar"
