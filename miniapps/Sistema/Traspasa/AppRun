#!/bin/bash
# Traspasa — copia el sistema instalado a otra partición y la deja arrancable
# por UEFI (rEFInd). La copia es siempre incremental: si la partición está
# vacía se copia todo y si ya tiene una copia solo se actualiza lo que cambió.
# El trabajo con privilegios lo hace traspasa-worker, en esta misma carpeta.
set -u

DIR=$(dirname "$(readlink -f "$0")")
WORKER="$DIR/traspasa-worker"

case $LANG in
    es*) T_TITLE="Traspasa"
         T_NOUEFI="Este equipo no arrancó en modo UEFI, así que no se puede preparar el arranque del sistema traspasado.\n\nArranque en modo UEFI y vuelva a intentarlo."
         T_NOTOOL="Falta una herramienta necesaria:"
         T_ANALIZA="Analizando el sistema y las particiones…\nSe está calculando el espacio necesario."
         T_ERRINSPECT="No se pudo analizar el sistema. ¿Se canceló la autenticación?"
         T_NOPART="No se encontró ninguna partición que pueda recibir el sistema.\n\nPrepare (particione y formatee) el disco de destino antes de usar esta aplicación."
