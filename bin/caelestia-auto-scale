#!/usr/bin/env python3
"""Autodetecta y aplica la escala de cada output según su DPI físico.

Sustituye la idea de fijar `scale` a mano por conector en wayfire.ini, que
no es portable: dos máquinas distintas (p.ej. el panel del Surface y el del
iMac) pueden compartir el mismo nombre de conector (eDP-1), así que una
sección `[output:eDP-1]` estática aplicaría la escala equivocada según en
qué equipo arranque el pendrive.

Usa `wlr-randr --json` (protocolo wlr-output-management, estándar en
cualquier compositor wlroots) para leer tamaño físico + modo nativo de cada
output, calcula el DPI y elige una escala entera (1/2/3 — nada de
fraccionario, para no arrastrar apps que no soportan wp-fractional-scale-v1
y salen borrosas). Si la escala calculada difiere de la actual, la aplica en
vivo con `wlr-randr --output NAME --scale X` (nunca toca wayfire.ini).

Un fichero opcional `~/.config/caelestia/auto-scale-overrides.json`
(`{"<make>|<model>|<serial>|<WxH mm>": <escala>}`) permite fijar a mano la
escala de un panel concreto si el heurístico se equivoca; tiene prioridad
sobre el cálculo por DPI. La clave identifica el panel por EDID, no por
conector, así que sigue siendo portable entre máquinas.

Si hay un layout guardado en `~/.config/caelestia/output-layouts.json` para
la identidad del panel (mismo formato de clave), tiene prioridad sobre todo
lo anterior y se restaura modo+posición+transform+escala completos en vez de
solo la escala. Ese fichero lo escribe `caelestia-save-layout`, invocado por
un wdisplays parcheado cada vez que aplicas cambios ahí visualmente.

Pasada inicial al arrancar + reconciliación en cada `output-added` (docking
en caliente), vía conexión IPC persistente a ipc-rules (mismo patrón que
caelestia-ws-watch). Log en /tmp/caelestia-autoscale.log.

Algunas pantallas (una LG TV por HDMI en este equipo) tardan en asentar el
EDID/modo real tras conectarse, y Wayfire reaplica mientras tanto su config
estática del .ini (sección `[output]`/`[output:default]`, mode=auto → cae al
modo de rescate 720x400 si el EDID no marca preferido) SIN que eso dispare
`output-added` en la IPC. Para cazarlo sin quedarnos sondeando para siempre,
tras el arranque y tras cada `output-added` se reintenta unas pocas veces
más (FOLLOWUP_DELAYS) y luego se vuelve a bloquear en el socket sin sondear.
"""
import glob
import json
import math
import os
import select
import socket
import struct
import subprocess
import sys
import time

OVERRIDES_PATH = os.path.expanduser('~/.config/caelestia/auto-scale-overrides.json')
LAYOUTS_PATH = os.path.expanduser('~/.config/caelestia/output-layouts.json')
LOG_PATH = '/tmp/caelestia-autoscale.log'

# Tras el arranque o un output-added, reintentos a estos plazos (segundos)
# para cazar un asentamiento tardío de EDID que no dispara ningún evento.
# Agotada la lista, se vuelve a bloquear en el socket sin sondear más.
FOLLOWUP_DELAYS = [3, 8, 15, 30, 60, 120]

TRANSFORM_NAMES = {
    0: 'normal',
    1: '90',
    2: '180',
    3: '270',
    4: 'flipped',
    5: 'flipped-90',
    6: 'flipped-180',
    7: 'flipped-270',
}

# DPI físico (diagonal) a partir del cual se usa cada escala entera.
# El corte de 3x va alto a propósito: un panel de portátil HiDPI típico
# (Surface Book 3: 3000x2000 a 13,5" = 264 dpi) se usa a 2x; 3x solo tiene
# sentido en densidades de ~4K en 13" (330+ dpi) o superiores.
SCALE_THRESHOLDS = [
    (320, 3),
    (150, 2),
    (0, 1),
]


def log(msg):
    try:
        with open(LOG_PATH, 'a') as f:
            f.write(time.strftime('%H:%M:%S ') + msg + '\n')
    except OSError:
        pass


def recv_msg(s):
    hdr = b''
    while len(hdr) < 4:
        chunk = s.recv(4 - len(hdr))
        if not chunk:
            return None
        hdr += chunk
    n = struct.unpack('<I', hdr)[0]
    data = b''
    while len(data) < n:
        chunk = s.recv(n - len(data))
        if not chunk:
            return None
        data += chunk
    return json.loads(data)


def send_msg(s, payload):
    msg = json.dumps(payload).encode()
    s.send(struct.pack('<I', len(msg)) + msg)


def identity_key(o):
    make = (o.get('make') or '').strip()
    model = (o.get('model') or '').strip()
    serial = (o.get('serial') or '').strip()
    ps = o.get('physical_size') or {}
    return f"{make}|{model}|{serial}|{ps.get('width', 0)}x{ps.get('height', 0)}"


def load_overrides():
    try:
        with open(OVERRIDES_PATH) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def load_layouts():
    try:
        with open(LAYOUTS_PATH) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def mode_is_advertised(o, layout):
    """¿El modo guardado está en la lista que anuncia el panel?

    wdisplays permite fijar resoluciones arbitrarias, que el compositor
    acepta como modo personalizado pero la pantalla nunca lista. Para esas
    hay que pedir `--custom-mode`; `--mode` solo admite las anunciadas.
    """
    target_hz = layout.get('refresh_mhz', 0) / 1000.0
    return any(
        m.get('width') == layout.get('width') and
        m.get('height') == layout.get('height') and
        abs(m.get('refresh', 0) - target_hz) < 0.05
        for m in o.get('modes', [])
    )


def layout_matches_current(o, layout):
    mode = next((m for m in o.get('modes', []) if m.get('current')), None)
    if not mode:
        return False
    pos = o.get('position') or {}
    target_hz = layout.get('refresh_mhz', 0) / 1000.0
    return (
        mode.get('width') == layout.get('width') and
        mode.get('height') == layout.get('height') and
        abs(mode.get('refresh', 0) - target_hz) < 0.05 and
        pos.get('x') == layout.get('x') and
        pos.get('y') == layout.get('y') and
        abs((o.get('scale') or 1.0) - layout.get('scale', 1.0)) < 0.01 and
        o.get('transform') == TRANSFORM_NAMES.get(layout.get('transform', 0), 'normal')
    )


def pick_scale(dpi):
    for threshold, scale in SCALE_THRESHOLDS:
        if dpi >= threshold:
            return scale
    return 1


def compute_scale(o, overrides):
    key = identity_key(o)
    if key in overrides:
        return float(overrides[key]), f"override {key!r}"

    ps = o.get('physical_size') or {}
    w_mm, h_mm = ps.get('width') or 0, ps.get('height') or 0
    mode = next((m for m in o.get('modes', []) if m.get('current')), None)
    if not mode or w_mm <= 0 or h_mm <= 0:
        return 1.0, "sin tamaño físico/modo, fallback 1x"

    diag_px = math.hypot(mode['width'], mode['height'])
    diag_in = math.hypot(w_mm, h_mm) / 25.4
    dpi = diag_px / diag_in
    return float(pick_scale(dpi)), f"{dpi:.0f} dpi"


def wlr_randr_outputs():
    proc = subprocess.run(['wlr-randr', '--json'], capture_output=True, text=True, timeout=5)
    return json.loads(proc.stdout)


def apply_scale(name, scale, reason):
    log(f"{name}: aplicando escala {scale} ({reason})")
    proc = subprocess.run(['wlr-randr', '--output', name, '--scale', f'{scale:.6f}'],
                          capture_output=True, text=True, timeout=5)
    if proc.returncode != 0:
        log(f"{name}: wlr-randr falló (exit {proc.returncode}): {proc.stderr.strip()}")


def apply_layout(name, layout, reason, custom_mode=False):
    hz = layout.get('refresh_mhz', 0) / 1000.0
    transform = TRANSFORM_NAMES.get(layout.get('transform', 0), 'normal')
    mode_flag = '--custom-mode' if custom_mode else '--mode'
    log(f"{name}: restaurando layout {layout['width']}x{layout['height']}@{hz:.3f}Hz"
        f"{' (personalizado)' if custom_mode else ''} "
        f"pos {layout['x']},{layout['y']} scale {layout['scale']} transform {transform} ({reason})")
    proc = subprocess.run(['wlr-randr', '--output', name,
                           mode_flag, f"{layout['width']}x{layout['height']}@{hz:.6f}Hz",
                           '--pos', f"{layout['x']},{layout['y']}",
                           '--transform', transform,
                           '--scale', f"{layout['scale']:.6f}"],
                          capture_output=True, text=True, timeout=5)
    if proc.returncode != 0:
        log(f"{name}: wlr-randr falló restaurando layout (exit {proc.returncode}): {proc.stderr.strip()}")


def reconcile(quiet=False):
    overrides = load_overrides()
    layouts = load_layouts()
    try:
        outputs = wlr_randr_outputs()
    except (subprocess.SubprocessError, json.JSONDecodeError, OSError, ValueError) as e:
        log(f"wlr-randr --json falló: {e}")
        return

    for o in outputs:
        if not o.get('enabled') or not o.get('name'):
            continue

        layout = layouts.get(identity_key(o))
        if layout and layout.get('enabled', True):
            if layout_matches_current(o, layout):
                if not quiet:
                    log(f"{o['name']}: ya coincide con el layout guardado, sin cambios")
            else:
                apply_layout(o['name'], layout, f"layout guardado para {identity_key(o)!r}",
                             custom_mode=not mode_is_advertised(o, layout))
            continue

        current = o.get('scale') or 1.0
        target, reason = compute_scale(o, overrides)
        if abs(current - target) > 0.01:
            apply_scale(o['name'], target, reason)
        elif not quiet:
            log(f"{o['name']}: ya en {current} ({reason}), sin cambios")


def main():
    reconcile()

    sock_path = os.environ.get('WAYFIRE_SOCKET', '')
    if not sock_path:
        sockets = glob.glob(f"/run/user/{os.getuid()}/wayfire*.socket")
        if not sockets:
            log("no se encontró el socket de Wayfire, saliendo")
            return
        sock_path = sockets[0]

    s = socket.socket(socket.AF_UNIX)
    s.connect(sock_path)
    send_msg(s, {'method': 'window-rules/events/watch',
                 'data': {'events': ['output-added']}})
    recv_msg(s)  # respuesta {"result": "ok"} de la suscripción

    pending_delays = list(FOLLOWUP_DELAYS)
    next_check = time.monotonic() + pending_delays.pop(0)

    while True:
        timeout = max(0.0, next_check - time.monotonic()) if next_check is not None else None
        ready, _, _ = select.select([s], [], [], timeout)

        if not ready:
            reconcile(quiet=True)
            next_check = time.monotonic() + pending_delays.pop(0) if pending_delays else None
            continue

        msg = recv_msg(s)
        if msg is None:
            return  # wayfire cerró el socket (fin de sesión)
        if msg.get('event') == 'output-added':
            log("output-added, reconciliando")
            reconcile()
            pending_delays = list(FOLLOWUP_DELAYS)
            next_check = time.monotonic() + pending_delays.pop(0)


if __name__ == '__main__':
    main()
