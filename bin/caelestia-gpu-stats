#!/usr/bin/env python3
# Métricas unificadas de todas las GPUs del sistema, en JSON:
#   [{"name": str, "vendor": "nvidia"|"amd"|"intel"|str, "usage": 0-100|null, "temp": °C|null}]
# usage/temp son null cuando el driver no expone esa métrica (la UI muestra "—").
# Backends: nvidia-smi (propietario), amdgpu (sysfs), i915/xe (fdinfo DRM
# muestreado ~350ms, solo ve clientes del propio usuario), nouveau (hwmon).
# En Intel, si fdinfo no expone contadores por motor (gen6/gen7 y kernels
# antiguos no lo hacen), se recurre al PMU de i915 vía perf. Ese respaldo solo
# entra cuando fdinfo no ha dado nada: las máquinas donde fdinfo ya funciona
# siguen exactamente igual.

import ctypes
import glob
import json
import os
import platform
import re
import struct
import subprocess
import sys
import time

SAMPLE_MS = 350

# __NR_perf_event_open, que es específico de cada arquitectura
PERF_EVENT_OPEN_NR = {
    "x86_64": 298,
    "aarch64": 241,
    "i686": 336,
    "armv7l": 364,
}


def perf_event_open(pmu_type, config, cpu):
    """fd de un contador perf, o None si el kernel lo deniega.

    Con kernel.perf_event_paranoid >= 3 esto devuelve EACCES para un usuario
    normal; ahí simplemente no hay métrica y se informa null.
    """
    nr = PERF_EVENT_OPEN_NR.get(platform.machine())
    if nr is None:
        return None

    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.syscall.restype = ctypes.c_int
        libc.syscall.argtypes = [ctypes.c_long, ctypes.c_void_p,
                                 ctypes.c_int, ctypes.c_int,
                                 ctypes.c_int, ctypes.c_ulong]
    except OSError:
        return None

    # struct perf_event_attr: type @0, size @4, config @8. El resto a cero
    # deja el contador habilitado y contando desde ya.
    attr = bytearray(128)
    struct.pack_into("<IIQ", attr, 0, pmu_type, 128, config)
    buf = (ctypes.c_char * 128).from_buffer(attr)

    fd = libc.syscall(nr, ctypes.byref(buf), -1, cpu, -1, 0)
    return fd if fd >= 0 else None


def pmu_dir(driver, pdev):
    """Directorio sysfs del PMU: i915_0000_00_02_0 con varias GPUs, i915 si hay una."""
    slug = pdev.replace(":", "_").replace(".", "_")
    for candidate in (f"/sys/devices/{driver}_{slug}", f"/sys/devices/{driver}"):
        if os.path.isdir(os.path.join(candidate, "events")):
            return candidate
    return None


def pmu_open_busy(driver, pdev):
    """Abre un contador por motor (rcs/bcs/vcs/vecs). [(nombre, fd)] o []."""
    base = pmu_dir(driver, pdev)
    if base is None:
        return []

    pmu_type = read_int(os.path.join(base, "type"))
    if pmu_type is None:
        return []

    cpumask = read(os.path.join(base, "cpumask")) or "0"
    try:
        cpu = int(cpumask.split(",")[0].split("-")[0])
    except ValueError:
        cpu = 0

    counters = []
    events = os.path.join(base, "events")
    for name in sorted(os.listdir(events)):
        if not name.endswith("-busy"):
            continue
        spec = read(os.path.join(events, name))
        if not spec or not spec.startswith("config="):
            continue
        try:
            config = int(spec.split("=", 1)[1].strip(), 0)
        except ValueError:
            continue
        fd = perf_event_open(pmu_type, config, cpu)
        if fd is not None:
            counters.append((name, fd))

    return counters


def pmu_read(counters):
    """{motor: nanosegundos ocupados acumulados}."""
    values = {}
    for name, fd in counters:
        try:
            # Sin lseek: un fd de perf no es buscable (ESPIPE) y cada read()
            # devuelve ya el valor actual del contador.
            raw = os.read(fd, 8)
        except OSError:
            continue
        if len(raw) == 8:
            values[name] = struct.unpack("<Q", raw)[0]
    return values


def pmu_busy(before, after, dt_ns):
    """% de uso: el motor más ocupado, igual criterio que con fdinfo."""
    if not before or not after or dt_ns <= 0:
        return None
    deltas = [after[k] - before[k] for k in after if k in before]
    deltas = [d for d in deltas if d >= 0]
    if not deltas:
        return None
    return min(100.0, max(deltas) * 100.0 / dt_ns)


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def read_int(path):
    v = read(path)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def nvidia_gpus():
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=name,utilization.gpu,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    if out.returncode != 0:
        return []
    gpus = []
    for line in out.stdout.strip().splitlines():
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < 3:
            continue

        def num(s):
            try:
                return float(s)
            except ValueError:
                return None
        gpus.append({"name": parts[0], "vendor": "nvidia",
                     "usage": num(parts[1]), "temp": num(parts[2])})
    return gpus


def hwmon_temp(dev):
    """Temperatura del hwmon propio del dispositivo (edge/GPU core preferidos)."""
    best = None
    for hw in glob.glob(os.path.join(dev, "hwmon/hwmon*")):
        for tf in sorted(glob.glob(os.path.join(hw, "temp*_input"))):
            v = read_int(tf)
            if v is None:
                continue
            v /= 1000
            label = (read(tf.replace("_input", "_label")) or "").lower()
            if label in ("edge", "gpu core", "junction"):
                return v
            if best is None:
                best = v
    return best


def coretemp_package():
    """Temperatura de paquete de la CPU (la iGPU Intel comparte die)."""
    for hw in glob.glob("/sys/class/hwmon/hwmon*"):
        if read(os.path.join(hw, "name")) == "coretemp":
            v = read_int(os.path.join(hw, "temp1_input"))
            if v is not None:
                return v / 1000
    return None


def pci_name(pdev):
    try:
        out = subprocess.run(["lspci", "-s", pdev], capture_output=True,
                             text=True, timeout=5).stdout.strip()
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return ""
    if ":" not in out:
        return ""
    name = out.split(":", 2)[-1].strip()
    # "TU117M [GeForce GTX 1650 Mobile / Max-Q]" -> lo de dentro del corchete
    m = re.search(r"\[([^]]+)\]", name)
    if m:
        name = m.group(1)
    name = re.sub(r"\s*\(rev [^)]*\)$", "", name)
    name = re.sub(r"^(Intel|NVIDIA|AMD|ATI) (Corporation |Technologies )?", "", name)
    return name.strip()


def drm_engine_sample(driver, pdev):
    """{client_id: {engine: ns_acumulados}} de los fd DRM legibles (mismo usuario)."""
    clients = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        fd_dir = f"/proc/{pid}/fd"
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                if not os.readlink(f"{fd_dir}/{fd}").startswith("/dev/dri/"):
                    continue
            except OSError:
                continue
            info = {}
            try:
                with open(f"/proc/{pid}/fdinfo/{fd}") as f:
                    for line in f:
                        if line.startswith("drm-"):
                            k, _, v = line.partition(":")
                            info[k.strip()] = v.strip()
            except OSError:
                continue
            if info.get("drm-driver") != driver:
                continue
            if info.get("drm-pdev", pdev) != pdev:
                continue
            cid = info.get("drm-client-id")
            if cid is None:
                continue
            engines = {}
            for k, v in info.items():
                if k.startswith("drm-engine-"):
                    try:
                        engines[k] = int(v.split()[0])
                    except ValueError:
                        pass
            if engines:
                clients[cid] = engines
    return clients


def fdinfo_busy(driver, pdev, before, after, dt_ns):
    """% de uso: máximo entre clases de motor de la suma de deltas por cliente."""
    totals = {}
    for cid, engines in after.items():
        prev = before.get(cid)
        if not prev:
            continue
        for engine, ns in engines.items():
            delta = ns - prev.get(engine, ns)
            if delta > 0:
                totals[engine] = totals.get(engine, 0) + delta
    if dt_ns <= 0:
        return None
    if not totals:
        # No drm-engine-* counters at all means the driver does not expose
        # per-client busyness (i915 on gen6/gen7, for one). Reporting 0.0 here
        # would render as a permanent, believable "0%"; None renders as "—".
        return None
    return min(100.0, max(totals.values()) * 100.0 / dt_ns)


def main():
    gpus = nvidia_gpus()

    cards = [c for c in glob.glob("/sys/class/drm/card*")
             if re.fullmatch(r"card\d+", os.path.basename(c))]
    fdinfo_cards = []  # (índice en gpus, driver, pdev)
    for card in sorted(cards):
        dev = os.path.join(card, "device")
        try:
            drv = os.path.basename(os.path.realpath(os.path.join(dev, "driver")))
            pdev = os.path.basename(os.path.realpath(dev))
        except OSError:
            continue
        if drv == "nvidia":
            continue  # ya cubierta por nvidia-smi
        entry = {"name": pci_name(pdev) or f"GPU ({drv})", "vendor": drv,
                 "usage": None, "temp": hwmon_temp(dev)}
        if drv == "amdgpu":
            entry["vendor"] = "amd"
            busy = read_int(os.path.join(dev, "gpu_busy_percent"))
            entry["usage"] = float(busy) if busy is not None else None
        elif drv in ("i915", "xe"):
            entry["vendor"] = "intel"
            if entry["temp"] is None:
                entry["temp"] = coretemp_package()
            fdinfo_cards.append((len(gpus), drv, pdev))
        elif drv == "nouveau":
            entry["vendor"] = "nvidia"
        gpus.append(entry)

    if fdinfo_cards:
        # Los contadores del PMU se abren antes del muestreo para compartir la
        # misma ventana que fdinfo y no duplicar el tiempo de ejecución.
        pmu = {idx: pmu_open_busy(drv, pdev) for idx, drv, pdev in fdinfo_cards}
        pmu = {idx: c for idx, c in pmu.items() if c}

        before = {(d, p): drm_engine_sample(d, p) for _, d, p in fdinfo_cards}
        pmu_before = {idx: pmu_read(c) for idx, c in pmu.items()}
        t0 = time.monotonic_ns()
        time.sleep(SAMPLE_MS / 1000)
        dt = time.monotonic_ns() - t0
        for idx, drv, pdev in fdinfo_cards:
            after = drm_engine_sample(drv, pdev)
            busy = fdinfo_busy(drv, pdev, before[(drv, pdev)], after, dt)
            if busy is None and idx in pmu:
                busy = pmu_busy(pmu_before[idx], pmu_read(pmu[idx]), dt)
            gpus[idx]["usage"] = round(busy, 1) if busy is not None else None

        for counters in pmu.values():
            for _, fd in counters:
                try:
                    os.close(fd)
                except OSError:
                    pass

    json.dump(gpus, sys.stdout)
    print()


if __name__ == "__main__":
    main()
