#!/usr/bin/env python3
"""caelestia-audio-devices: puente PipeWire -> lista completa de salidas/entradas.

PROBLEMA QUE RESUELVE
---------------------
PipeWire solo crea un *nodo* (sink/source) por cada salida del **perfil activo**
de la tarjeta. Una tarjeta HDA tipica solo tiene perfiles excluyentes
("Analog Stereo Duplex", "Digital Stereo (HDMI) Output + Analog Stereo Input",
...), asi que en un momento dado existe UN solo sink: o los altavoces, o el
HDMI, nunca los dos. Cualquier UI que se limite a listar los nodos de PipeWire
(que es lo unico que expone Quickshell.Services.Pipewire) muestra una sola
salida y no deja cambiar a la otra.

GNOME/pavucontrol no listan nodos sino los **puertos** (routes) de cada tarjeta,
y al elegir uno cambian el perfil de la tarjeta. Este script hace lo mismo:
enumera los puertos de todos los dispositivos de audio y, para cada uno, calcula
que perfil hay que activar para que ese puerto pase a existir como nodo.

SALIDA (una linea de JSON compacto por cambio, o una sola con --once):

  {"devices":[{"id":62,"name":"alsa_card.pci-0000_00_1f.3",
               "description":"Built-in Audio","api":"alsa",
               "profile":3,"profileDescription":"...",
               "routes":[{"index":4,"direction":"Output",
                          "name":"hdmi-output-0","description":"HDMI / DisplayPort",
                          "product":"LG TV","type":"hdmi","icon":"video-display",
                          "priority":5900,"active":true,
                          "profile":3,"profileDescription":"...",
                          "device":7}]}]}

  - `profile` de la ruta = el perfil de MAYOR prioridad, entre los disponibles,
    que contiene esa ruta (misma heuristica que gnome-control-center: prefiere
    los duplex, que puntuan mas alto, para no perder el microfono).
  - `active` = la ruta esta activa ahora mismo en el perfil vigente.
  - Las rutas con available == "no" (jack desconectado, HDMI sin monitor) se
    descartan; son las que tampoco muestra GNOME.

MODO --select: activa un puerto.

  caelestia-audio-devices --select DEVICE_ID ROUTE_INDEX PROFILE_INDEX

  - Si el perfil pedido no es el vigente -> `wpctl set-profile`. WirePlumber
    elige sola la mejor ruta del perfil nuevo y mueve el sink por defecto, asi
    que no hace falta nada mas (verificado en vivo).
  - Si el perfil ya es el vigente (p.ej. Altavoces <-> Auriculares, que viven en
    el mismo perfil analogico) -> set-param Route, reutilizando el indice de
    `device` de la ruta activa: al no cambiar de perfil, es el mismo.

Lo consume shell/services/Audio.qml como Process permanente (patron de
caelestia-ws-watch).
"""

import argparse
import json
import subprocess
import sys
import time

AUDIO_DEVICE_CLASS = "Audio/Device"

# port.type -> nombre de icono XDG, por si la ruta no trae device.icon_name
FALLBACK_ICONS = {
    "speaker": "audio-speakers",
    "headphones": "audio-headphones",
    "headset": "audio-headset",
    "hdmi": "video-display",
    "mic": "audio-input-microphone",
    "bluetooth": "bluetooth",
}


def info_dict(entry):
    """Convierte el `info` de una route (["n", k, v, k, v, ...]) en un dict."""
    raw = entry.get("info") or []
    # El primer elemento es el numero de pares; el resto son k, v alternados.
    items = raw[1:] if raw and isinstance(raw[0], int) else raw
    return dict(zip(items[::2], items[1::2]))


def params_of(obj):
    return (obj.get("info") or {}).get("params") or {}


# Clase de media de un perfil -> direccion de las rutas que alimenta.
CLASS_DIRECTION = {"Audio/Sink": "Output", "Audio/Source": "Input"}


def profile_devices(profile):
    """Devices de la tarjeta que usa un perfil, por direccion.

    Cada perfil declara sus `classes` en la forma

        [2, ["Audio/Source", 1, "card.profile.devices", [0]],
            ["Audio/Sink",   1, "card.profile.devices", [7]]]

    Esto es la fuente de verdad para saber que puerto esta sonando: el param
    Route tarda un poco en reflejar un cambio de perfil (y en ese hueco puede
    venir vacio o con la ruta del perfil ANTERIOR), mientras que las classes del
    perfil activo son correctas desde el primer instante.
    """
    result = {"Output": set(), "Input": set()}

    classes = profile.get("classes") or []
    entries = classes[1:] if classes and isinstance(classes[0], int) else classes

    for entry in entries:
        if not isinstance(entry, list) or not entry:
            continue
        direction = CLASS_DIRECTION.get(entry[0])
        if direction is None:
            continue
        fields = dict(zip(entry[2::2], entry[3::2]))
        result[direction].update(fields.get("card.profile.devices") or [])

    return result


def build_payload(state):
    devices = []

    for obj in sorted(state.values(), key=lambda o: o.get("id", 0)):
        if obj.get("type") != "PipeWire:Interface:Device":
            continue
        props = (obj.get("info") or {}).get("props") or {}
        if props.get("media.class") != AUDIO_DEVICE_CLASS:
            continue

        params = params_of(obj)
        enum_profiles = {p["index"]: p for p in params.get("EnumProfile", [])}
        active_profiles = params.get("Profile") or []
        active_profile = active_profiles[0] if active_profiles else {}
        active_profile_index = active_profile.get("index")

        # Puertos que puede estar usando el perfil vigente, por direccion.
        live_devices = profile_devices(active_profile)

        def usable(route):
            return bool(set(route.get("devices") or []) & live_devices.get(route.get("direction"), set()))

        candidates = [
            r for r in params.get("EnumRoute", [])
            if r.get("available") != "no" and usable(r)
        ]

        # Ruta activa por direccion. El param Route manda, pero solo si encaja
        # con el perfil vigente: durante un cambio de perfil puede seguir
        # apuntando al puerto del perfil anterior o venir vacio, y entonces se
        # toma la de mayor prioridad, que es la que acabara eligiendo
        # WirePlumber.
        active_index = {}
        for direction in ("Output", "Input"):
            direction_candidates = [r for r in candidates if r.get("direction") == direction]
            if not direction_candidates:
                continue
            chosen = next(
                (r for r in params.get("Route", [])
                 if r.get("direction") == direction
                 and any(c.get("index") == r.get("index") for c in direction_candidates)),
                None,
            )
            active_index[direction] = (
                chosen["index"] if chosen
                else max(direction_candidates, key=lambda r: r.get("priority", 0))["index"]
            )

        routes = []
        for r in params.get("EnumRoute", []):
            if r.get("available") == "no":
                continue

            direction = r.get("direction")
            is_active = active_index.get(direction) == r.get("index")

            if is_active:
                target_profile = active_profile_index
            else:
                # Mejor perfil disponible que contiene esta ruta.
                profile_candidates = [
                    enum_profiles[i]
                    for i in r.get("profiles", [])
                    if i in enum_profiles and enum_profiles[i].get("available") != "no"
                ]
                if not profile_candidates:
                    # Ninguna forma de activar este puerto: no lo ofrecemos.
                    continue
                target_profile = max(
                    profile_candidates, key=lambda p: p.get("priority", 0)
                )["index"]

            rinfo = info_dict(r)
            port_type = rinfo.get("port.type", "")
            profile = enum_profiles.get(target_profile, {})

            routes.append({
                "index": r.get("index"),
                "direction": direction,
                "name": r.get("name"),
                "description": r.get("description"),
                "product": rinfo.get("device.product.name", ""),
                "type": port_type,
                "icon": rinfo.get("device.icon_name")
                        or FALLBACK_ICONS.get(port_type, ""),
                "priority": r.get("priority", 0),
                "active": is_active,
                "profile": target_profile,
                "profileDescription": profile.get("description", ""),
                # Indice de device dentro de la tarjeta; sirve para casar la
                # ruta con su nodo (node prop `card.profile.device`).
                "devices": r.get("devices", []),
            })

        routes.sort(key=lambda r: -r["priority"])

        devices.append({
            "id": obj.get("id"),
            "name": props.get("device.name", ""),
            "description": props.get("device.description", ""),
            "api": props.get("device.api", ""),
            "profile": active_profile_index,
            "profileDescription": active_profile.get("description", ""),
            "routes": routes,
        })

    return {"devices": devices}


def dump_state():
    out = subprocess.run(
        ["pw-dump", "-N"], capture_output=True, text=True, check=True
    ).stdout
    return {o["id"]: o for o in json.loads(out) if "id" in o}


def emit(payload):
    sys.stdout.write(json.dumps(payload, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def publish(last):
    """Vuelca el estado y lo emite solo si cambia. Devuelve el ultimo emitido."""
    payload = build_payload(dump_state())
    if payload != last:
        emit(payload)
        return payload
    return last


def cmd_once():
    emit(build_payload(dump_state()))
    return 0


def device_signature(obj):
    """Parte de un evento de Device que puede alterar la lista de puertos.

    Deliberadamente NO incluye volumenes ni mute: en una tarjeta ALSA el volumen
    vive dentro del param Route, asi que cada paso de un slider genera un evento
    de Device. Comparando solo indices y disponibilidad, arrastrar el volumen
    sale gratis y seguimos reaccionando a cambios de perfil y a enchufar o
    desenchufar auriculares/HDMI.
    """
    params = params_of(obj)
    sig = {}
    if "Profile" in params:
        sig["profile"] = [p.get("index") for p in params["Profile"]]
    if "Route" in params:
        sig["route"] = [
            [r.get("direction"), r.get("index"), r.get("device")]
            for r in params["Route"]
        ]
    if "EnumProfile" in params:
        sig["enumProfile"] = [
            [p.get("index"), p.get("available")] for p in params["EnumProfile"]
        ]
    if "EnumRoute" in params:
        sig["enumRoute"] = [
            [r.get("index"), r.get("available"), r.get("profiles")]
            for r in params["EnumRoute"]
        ]
    return sig


def relevant(batch, signatures):
    """True si el lote de eventos puede cambiar la lista de puertos.

    Solo miran los objetos Device: los nodos no entran en la salida de este
    script (la UI casa nodo y puerto por su cuenta), asi que sus eventos —los
    mas frecuentes— se ignoran por completo. `signatures` se actualiza in situ;
    los eventos en modo monitor son parciales, asi que solo se comparan los
    params que traiga cada uno.
    """
    changed = False

    for obj in batch:
        oid = obj.get("id")
        if oid is None:
            continue

        if "info" in obj and obj.get("info") is None:  # objeto eliminado
            if signatures.pop(oid, None) is not None:
                changed = True
            continue

        if obj.get("type") != "PipeWire:Interface:Device":
            continue

        previous = signatures.setdefault(oid, {})
        for key, value in device_signature(obj).items():
            if previous.get(key) != value:
                previous[key] = value
                changed = True

    return changed


# Margen para que WirePlumber asiente las rutas tras un cambio de perfil: entre
# el "perfil nuevo activo" y el "ruta nueva activa" hay un instante en que la
# tarjeta no tiene ninguna salida activa.
SETTLE_SECONDS = 0.2

# Segunda pasada de confirmacion. Es imprescindible, no una optimizacion: si el
# volcado cae dentro de ese instante sin ruta activa, el estado publicado se
# queda mal PARA SIEMPRE, porque asentar la ruta no genera mas eventos que
# despierten al watcher. Con la confirmacion, ese estado transitorio dura ~1 s.
CONFIRM_SECONDS = 0.8


def cmd_watch():
    last = None
    proc = subprocess.Popen(
        ["pw-dump", "-mN"], stdout=subprocess.PIPE, text=True, bufsize=1
    )

    # pw-dump -m escribe un array JSON indentado por lote de eventos (el primero
    # es el volcado completo), concatenados sin separador. Los lotes se cierran
    # con un "]" en la columna 0, asi que se acumula por lineas hasta verlo: es
    # O(n), mientras que intentar raw_decode() linea a linea reparsea el buffer
    # entero cada vez y tarda segundos con el volcado inicial de ~140 KB.
    lines = []
    pending = False
    first = True
    signatures = {}

    try:
        while True:
            line = proc.stdout.readline()
            if not line:
                break
            lines.append(line)

            if line.rstrip("\n") != "]":
                continue

            try:
                batch = json.loads("".join(lines))
            except ValueError:
                # Lote ilegible: se descarta y se sigue con el siguiente.
                batch = []
            lines = []

            if relevant(batch, signatures) or first:
                pending = True
            first = False

            if pending:
                pending = False
                time.sleep(SETTLE_SECONDS)
                last = publish(last)
                time.sleep(CONFIRM_SECONDS)
                last = publish(last)
    except KeyboardInterrupt:
        pass
    finally:
        proc.terminate()

    return 0


def current_profile(device_id):
    state = dump_state()
    obj = state.get(device_id)
    if not obj:
        return None, None
    params = params_of(obj)
    active = params.get("Profile") or []
    routes = params.get("Route", [])
    return (active[0].get("index") if active else None), routes


def cmd_select(device_id, route_index, profile_index):
    active_profile, active_routes = current_profile(device_id)
    if active_profile is None:
        print(f"dispositivo {device_id} no encontrado", file=sys.stderr)
        return 1

    if profile_index != active_profile:
        # Cambio de perfil: WirePlumber activa la mejor ruta del perfil nuevo y
        # reasigna el sink/source por defecto.
        subprocess.run(
            ["wpctl", "set-profile", str(device_id), str(profile_index)], check=True
        )
        return 0

    # Mismo perfil (p.ej. Altavoces <-> Auriculares): basta con mover la ruta.
    # El indice de `device` no cambia dentro de un mismo perfil, asi que se
    # reutiliza el de la ruta activa de esa direccion.
    state = dump_state()
    enum_routes = {
        r["index"]: r for r in params_of(state.get(device_id, {})).get("EnumRoute", [])
    }
    target = enum_routes.get(route_index)
    if target is None:
        print(f"ruta {route_index} no existe en {device_id}", file=sys.stderr)
        return 1

    card_device = None
    for r in active_routes:
        if r.get("direction") == target.get("direction"):
            card_device = r.get("device")
            break
    if card_device is None:
        candidates = target.get("devices") or []
        if not candidates:
            print(f"ruta {route_index} sin device asociado", file=sys.stderr)
            return 1
        card_device = candidates[0]

    subprocess.run([
        "pw-cli", "set-param", str(device_id), "Route",
        "{ index: %d, device: %d, save: true }" % (route_index, card_device),
    ], check=True, stdout=subprocess.DEVNULL)
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--once", action="store_true",
                    help="vuelca la lista una vez y sale")
    ap.add_argument("--select", nargs=3, metavar=("DEVICE", "ROUTE", "PROFILE"),
                    type=int, help="activa un puerto de audio")
    args = ap.parse_args()

    if args.select:
        return cmd_select(*args.select)
    if args.once:
        return cmd_once()
    return cmd_watch()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as e:
        print(f"fallo al ejecutar {e.cmd}: {e.returncode}", file=sys.stderr)
        sys.exit(e.returncode)
